# Server Port
PORT=5000

# Client Application URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/gatherly?retryWrites=true&w=majority
MONGO_URI=

# JWT Secret Key
JWT_SECRET=gatherly_super_secret_jwt_key_2026_dev_env

# Node Environment
NODE_ENV=development

# SMTP Email Service Configuration (Optional for development; defaults to simulated delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GATHERLY Security <security@gatherly.campus.edu>"


