# ==============================================================================
# GATHERLY - Root Environment Configuration Example
# ==============================================================================

# Backend Port
PORT=5000

# Client Application URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or local instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gatherly?retryWrites=true&w=majority

# JSON Web Token Secret
JWT_SECRET=gatherly_super_secret_jwt_key_2026_dev_env

# Frontend API Base URL (used by Vite in frontend/.env)
VITE_API_URL=http://localhost:5000/api

